# Application
APP_NAME=Agent Console API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Local development endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/agent_console.db
REDIS_URL=redis://localhost:6379/0

# Docker-internal endpoint (used by docker-compose.yml)
COMPOSE_REDIS_URL=redis://redis:6379/0

# LiteLLM model selection and config file
LITELLM_DEFAULT_MODEL=
MODELS_CONFIG_PATH=config/models.yaml
MODEL_REQUEST_TIMEOUT_SECONDS=60

# Provider credential placeholders. Put real values only in .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=

# Security / feature flags
# Set a strong token to enable API/WebSocket auth (backend default is open).
APP_API_TOKEN=
# Enable the Agent tool-calling loop (true / false).
AGENT_TOOLS_ENABLED=true
# Task scheduling (C-169)
# queue  = API only enqueues; a separate `python -m app.worker` process consumes
#          the persistent queue (default, used by docker-compose `worker` service)
# inline = API executes tasks in-process (fallback / single-box debugging)
TASK_EXECUTION_MODE=queue
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_CONCURRENCY=2
# C-170: lease renewal while a task runs, and how often expired leases are swept.
# Renewal interval must stay well below the lease length, or long tasks get
# re-queued mid-flight and run twice.
WORKER_LEASE_RENEW_INTERVAL_SECONDS=30
WORKER_RECOVER_INTERVAL_SECONDS=60

# Cross-instance event bus / distributed lock (C-169)
# true  = broadcast WS events through Redis Pub/Sub so multiple backend
#         instances stay in sync (requires REDIS_URL to be reachable)
# false = single-instance in-process broadcast only
EVENT_BUS_ENABLED=true
DISTRIBUTED_LOCK_ENABLED=true

# External agent bridge (Codex CLI / Cursor / Antigravity)
BRIDGE_ROOT_DIR=data/bridges
BRIDGE_OUTPUT_POLL_TIMEOUT_SECONDS=600
# Codex bridge: skip the git trust check (task dirs are not git repos by
# default). Set false once worktree isolation (P5) makes task dirs git repos.
BRIDGE_CODEX_SKIP_GIT_CHECK=true
# Codex bridge: per-task timeout in seconds.
BRIDGE_CODEX_TIMEOUT_SECONDS=300
